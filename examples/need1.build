rule task("3") {
  print("Running 3");
  "value=3"
}


rule task("2") {
  print("Running 2")
}


rule file(path) {
  print("Building file");
  print("Path: {path}");
  print("after print")
}


rule task("1") {
  print("Running 1");
  need(task("2"));
  print_debug("Outstanding: #2");
  let var = need(task("3"));
  print("Running file task");
  need(file(path="test"));
  print("var3: {var}");
  print("Finishing 1")


}
