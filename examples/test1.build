@dist/exe {

  # Declare variable for reuse
  # Inferred to be string
  let exe = "target/\"build\"/exe";

  # Need accepts one ore more targets
  need("Cargo.toml", "Cargo.lock");
  # glob returns a list of matching files
  need(glob("src/**/*"));

  # Note: Needs with multiple arguments and successive needs without
  # interspersed effects are parallel.

  # Actually build the code
  # bare shell forms are single line, no semicolon at the end
  `cargo build`

}
