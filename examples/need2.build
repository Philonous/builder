rule file(path) {
  `bash -c "echo hello > hello"`;
  print("Path: {path}");
  "hello"
}

rule task("1") {
  let hello = need(file(path="test"));
  let bla = need(file(path="bla"));
  # Check that the value is deferred
  print_debug(hello);
  assert_equal(hello, "hello");
  # Now hello should be forced and bla still be deferred
  print_debug(hello);
  print_debug(bla)
}
